  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "дом"
                kind: "query"
                name: "q"
                orig: "q"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /search"
            json: "{\"operationId\":\"searchQuotes\",\"parameters\":[{\"description\":\"Search query string to find in quotes\",\"in\":\"query\",\"name\":\"q\",\"required\":true,\"schema\":{\"example\":\"дом\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"properties\":{\"author\":{\"description\":\"Author of the quote\",\"example\":\"Catherine Schulman\",\"type\":\"string\"},\"date\":{\"description\":\"Date when the quote was said or published\",\"format\":\"date\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the quote\",\"example\":3,\"type\":\"integer\"},\"source\":{\"description\":\"Source or context of the quote\",\"example\":\"Закладка\",\"type\":\"string\"},\"text\":{\"description\":\"The quote text\",\"example\":\"Политика — это искусство возможного\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"List of quotes matching the search query\"},\"400\":{\"description\":\"Invalid search query\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/search"
          segments: [
            {
              lit: "search"
            }
          ]
          select: {
            exist: [
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 3
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /quote/{id}"
            json: "{\"operationId\":\"getQuoteById\",\"parameters\":[{\"description\":\"The unique identifier of the quote\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"example\":3,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"author\":{\"description\":\"Author of the quote\",\"example\":\"Catherine Schulman\",\"type\":\"string\"},\"date\":{\"description\":\"Date when the quote was said or published\",\"format\":\"date\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the quote\",\"example\":3,\"type\":\"integer\"},\"source\":{\"description\":\"Source or context of the quote\",\"example\":\"Закладка\",\"type\":\"string\"},\"text\":{\"description\":\"The quote text\",\"example\":\"Политика — это искусство возможного\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"The requested quote\"},\"404\":{\"description\":\"Quote not found\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/quote/{id}"
          segments: [
            {
              lit: "quote"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          contract: {
            id: "GET /quote/random"
            json: "{\"operationId\":\"getRandomQuote\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"author\":{\"description\":\"Author of the quote\",\"example\":\"Catherine Schulman\",\"type\":\"string\"},\"date\":{\"description\":\"Date when the quote was said or published\",\"format\":\"date\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the quote\",\"example\":3,\"type\":\"integer\"},\"source\":{\"description\":\"Source or context of the quote\",\"example\":\"Закладка\",\"type\":\"string\"},\"text\":{\"description\":\"The quote text\",\"example\":\"Политика — это искусство возможного\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"A random quote\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/quote/random"
          segments: [
            {
              lit: "quote"
            }
            {
              lit: "random"
            }
          ]
          select: {
            "$action": "random"
          }
          transform: {
