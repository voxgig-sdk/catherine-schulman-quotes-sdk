# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: [
    {
      format: "date"
      name: "date"
      req: false
      short: "Release date of the episode"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Description or summary of the episode"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the episode"
      type: "`$INTEGER`"
    }
    {
      name: "program"
      req: false
      short: "Name of the program"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the episode"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL to the episode"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/last/episodes/all"
          segments: [
            {
              lit: "last"
            }
            {
              lit: "episodes"
            }
            {
              lit: "all"
            }
          ]
          select: {
            "$action": "all"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 3
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/episodes/zakladka/{id}"
          segments: [
            {
              lit: "episodes"
            }
            {
              lit: "zakladka"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/episodes/zakladka/random"
          segments: [
            {
              lit: "episodes"
            }
            {
              lit: "zakladka"
            }
            {
              lit: "random"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
